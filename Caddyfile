# Caddy gère automatiquement le certificat Let's Encrypt et le renouvellement.
# Le HTTP est automatiquement redirigé vers HTTPS par Caddy (comportement par défaut).
#
# Ce Caddy ne sert QUE le backend (API + routes publiques /q /m /media) sur
# api.kartaqr.fr. Le frontend Angular est hébergé séparément sur Cloudflare
# (https://kartaqr.fr) et ne passe pas par ce reverse proxy.
#
# Ajouter une adresse email réelle si tu veux les notifications d'expiration
# Let's Encrypt (première ligne du bloc : `tls ton-email@example.com`).

api.kartaqr.fr {
    reverse_proxy backend:8080

    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}
