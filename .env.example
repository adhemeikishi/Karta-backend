# Copier ce fichier en ".env" sur le VPS et remplir les vraies valeurs.
# Ce fichier ".env.example" peut être commité (pas de vrais secrets dedans).
# Le fichier ".env" réel ne doit JAMAIS être commité (voir .gitignore).

# --- PostgreSQL production ---
DB_NAME=qrmenu
DB_USER=qrmenu_prod
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- API admin (Basic Auth) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- Domaine QR (celui encodé dans les QR codes) ---
QR_BASE_URL=https://qr.mondomaine.fr
