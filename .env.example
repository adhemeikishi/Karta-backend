# Copier ce fichier en ".env" sur le VPS et remplir les vraies valeurs.
# Ce fichier ".env.example" peut être commité (pas de vrais secrets dedans).
# Le fichier ".env" réel ne doit JAMAIS être commité (voir .gitignore).

# --- PostgreSQL production ---
DB_NAME=qrmenu
DB_USER=qrmenu_prod
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- API admin (Basic Auth) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- Domaine QR (celui encodé dans les QR codes, sert /q /m /media) ---
# ATTENTION : figé dès la première impression de QR. Ne jamais changer ensuite.
QR_BASE_URL=https://api.kartaqr.fr

# --- Origine(s) autorisée(s) pour le back-office Angular (CORS, CSV) ---
CORS_ALLOWED_ORIGINS=https://kartaqr.fr

# --- KartaAI : extraction d'une carte PDF vers un menu structuré (optionnel) ---
# Sans clé, KartaAI est simplement désactivé ; le reste du produit fonctionne.
KARTA_AI_API_KEY=
# Modèle configurable : il évolue plus vite que le code.
KARTA_AI_MODEL=claude-opus-5

